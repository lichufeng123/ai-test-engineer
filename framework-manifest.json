{
  "name": "ai-test-engineer",
  "framework_version": "0.13.0a5",
  "documentation_version": "0.13.0a5",
  "exploration_handoff_schema": "schemas/exploration-handoff.schema.json",
  "python": ">=3.9",
  "canonical_handbook": "docs/FRAMEWORK.md",
  "canonical_skills_dir": ".agents/skills",
  "plugin_manifest_template": "plugin/plugin.json",
  "case_generation_adapter": "approved-test-case-baseline",
  "work_item_artifact_registry_schema": "schemas/work-item-artifacts.schema.json",
  "rapid_test_charter_schema": "schemas/rapid-test-charter.schema.json",
  "one_pass_plan_schema": "schemas/one-pass-test-plan.schema.json",
  "one_pass_results_schema": "schemas/one-pass-test-results.schema.json",
  "web_execution_routing_schema": "schemas/web-executor-routing.schema.json",
  "knowledge_registry_manifest_schema": "schemas/knowledge-registry-manifest.schema.json",
  "knowledge_registry_load_schema": "schemas/knowledge-registry-load.schema.json",
  "private_repository_integration_doc": "docs/PRIVATE_REPOSITORY_INTEGRATION.md",
  "private_repo_starter": "ai_test_framework.starter_private_repo",
  "supported_platforms": ["web", "api", "app", "h5", "miniapp"],
  "executor_adapters": ["playwright", "minium", "agent-device"],
  "adapter_roles": {
    "playwright": "formal web regression executor",
    "minium": "mini-app executor",
    "agent-device": "AI-first mobile device executor",
    "ego-lite": "first-round semantic and visual web discovery",
    "playwright-mcp": "optional locator assistance",
    "chrome-devtools-mcp": "network, console and performance diagnosis",
    "stagehand": "controlled locator and wait-condition repair proposals",
    "test-case-baseline": "approved case baseline adapter",
    "codex": "client integration guidance"
  },
  "web_browser_stack": {
    "formal_executor": "playwright-test",
    "discovery": ["ego-lite"],
    "locator_assistance": ["playwright-mcp"],
    "fallback": ["ego-lite"],
    "diagnosis": ["chrome-devtools-mcp"],
    "controlled_repair": ["stagehand"]
  },
  "optional_tools": {
    "video-check": ["ffprobe", "ffmpeg"],
    "test-recording-generate": ["macos-say", "ffmpeg", "ffprobe"],
    "agent-device": ["node>=22.12", "xcode", "adb"],
    "web-browser-stack": ["playwright-mcp", "chrome-devtools-mcp", "ego-lite", "stagehand"]
  }
}
