{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Readiness Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "requirement_baseline_id",
    "feature",
    "automation_scope",
    "case_requirements",
    "account_requirements",
    "fixture_requirements",
    "evidence_plan"
  ],
  "properties": {
    "business_fixture_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "case_id",
          "fixture_key",
          "version",
          "usage"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fixture_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "usage": {
            "enum": [
              "read",
              "write"
            ]
          }
        }
      }
    },
    "business_fixture_target_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "automation_scope": {
      "type": "object",
      "required": [
        "platforms",
        "environments",
        "case_ids"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "business_flow_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_case_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "case_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "required_role_ids",
          "required_fixture_ids",
          "required_environment_ids"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "required_role_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_fixture_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_environment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_execution_target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "required_hardware_fixture_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "execution_strategy": {
            "enum": [
              "ai_assisted",
              "deterministic",
              "human_semantic_review",
              "hybrid_required"
            ]
          },
          "ai_capability_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "capability_id": {
                  "type": "string",
                  "minLength": 1
                },
                "necessity": {
                  "enum": [
                    "required",
                    "recommended",
                    "optional"
                  ]
                },
                "supports_assertion_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": [
                "capability_id",
                "necessity"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "assertion_oracle_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "assertion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "required_conclusion_authority": {
                  "enum": [
                    "approved_semantic_gold",
                    "composite",
                    "deterministic_source",
                    "human_review_receipt"
                  ]
                },
                "oracle_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "usage": {
                  "enum": [
                    "authorization",
                    "product_outcome",
                    "semantic_quality",
                    "side_effect",
                    "state_persistence"
                  ]
                },
                "composite_authorities": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "approved_semantic_gold",
                      "deterministic_source",
                      "human_review_receipt"
                    ]
                  },
                  "minItems": 2,
                  "uniqueItems": true
                }
              },
              "required": [
                "assertion_id",
                "required_conclusion_authority",
                "oracle_refs",
                "usage"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "required_conclusion_authority": {
                        "const": "composite"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "composite_authorities"
                    ]
                  }
                }
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "account_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role_id",
          "purpose",
          "status"
        ],
        "properties": {
          "role_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "status": {
            "enum": [
              "needed",
              "available",
              "missing",
              "not_applicable"
            ]
          }
        }
      }
    },
    "fixture_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "purpose",
          "case_ids",
          "status"
        ],
        "properties": {
          "fixture_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "source_or_factory": {
            "type": "string"
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "needed",
              "available",
              "missing",
              "not_applicable"
            ]
          }
        }
      }
    },
    "execution_target_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "platform",
          "target_kind",
          "executor_id",
          "required_capabilities",
          "case_ids",
          "status"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "web",
              "app",
              "h5",
              "miniapp",
              "api",
              "database"
            ]
          },
          "target_kind": {
            "type": "string",
            "enum": [
              "physical",
              "simulator",
              "emulator",
              "browser",
              "service",
              "database"
            ]
          },
          "executor_id": {
            "type": "string",
            "minLength": 1
          },
          "os_family": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "needed",
              "available",
              "missing",
              "not_applicable"
            ]
          }
        }
      }
    },
    "hardware_fixture_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hardware_fixture_id",
          "fixture_type",
          "purpose",
          "case_ids",
          "status"
        ],
        "properties": {
          "hardware_fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "fixture_type": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "source_or_factory": {
            "type": "string"
          },
          "manual_preparation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "automated_validation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "needed",
              "available",
              "missing",
              "not_applicable"
            ]
          }
        }
      }
    },
    "evidence_plan": {
      "type": "object"
    },
    "manual_only_case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "planned"
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "password": {
      "not": {}
    },
    "token": {
      "not": {}
    },
    "cookie": {
      "not": {}
    },
    "credentials": {
      "not": {}
    },
    "catalog_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "catalog_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "ai_capabilities": {
      "type": "array",
      "items": {
        "$ref": "ai-test-capability-catalog.schema.json#/$defs/capability"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "oracle_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "oracle_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "approved_semantic_gold",
              "deterministic_source",
              "human_review_receipt"
            ]
          },
          "independence_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "oracle_id",
          "version",
          "sha256",
          "kind",
          "independence_basis"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "testability_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assessment_id": {
            "type": "string",
            "minLength": 1
          },
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "target_environment": {
            "type": "string",
            "minLength": 1
          },
          "cost_benefit": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "freeze_and_drift": {
            "type": "string",
            "minLength": 1
          },
          "retention_cleanup": {
            "type": "string",
            "minLength": 1
          },
          "oracle_gap": {
            "type": "string",
            "minLength": 1
          },
          "next_step": {
            "type": "string",
            "minLength": 1
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "instability_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "disposition": {
            "enum": [
              "build_testability_asset",
              "extend_fixture",
              "manual_only_pending_oracle",
              "not_applicable",
              "reuse_existing_fixture",
              "runtime_ai_required"
            ]
          }
        },
        "required": [
          "assessment_id",
          "feature_id",
          "basis",
          "target_environment",
          "cost_benefit",
          "owner",
          "freeze_and_drift",
          "retention_cleanup",
          "oracle_gap",
          "next_step",
          "case_ids",
          "instability_sources",
          "assets",
          "prerequisites",
          "disposition"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "resource_check_max_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "deterministic_fallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fallback_id": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "input_asset_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "approved_reference"
          },
          "question_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "review_status": {
            "const": "approved_reference"
          },
          "full_case_scope": {
            "const": true
          }
        },
        "required": [
          "fallback_id",
          "case_id",
          "capability_id",
          "question_id",
          "input_asset_id",
          "version",
          "kind",
          "question_sha256",
          "sha256",
          "review_status",
          "full_case_scope"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "catalog_ref",
          "oracle_resources",
          "testability_assessments"
        ],
        "properties": {
          "case_requirements": {
            "items": {
              "required": [
                "execution_strategy",
                "ai_capability_bindings",
                "assertion_oracle_bindings"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "catalog_ref"
              ]
            },
            {
              "required": [
                "ai_capabilities"
              ]
            },
            {
              "required": [
                "oracle_resources"
              ]
            },
            {
              "required": [
                "testability_assessments"
              ]
            }
          ]
        },
        "properties": {
          "case_requirements": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "execution_strategy"
                    ]
                  },
                  {
                    "required": [
                      "ai_capability_bindings"
                    ]
                  },
                  {
                    "required": [
                      "assertion_oracle_bindings"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
