{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-platform Run Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "approved_baseline",
    "case_ids",
    "execution_target_ids",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "approved_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "sha256"],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "case_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "execution_target_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "hardware_fixture_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "executor_id", "target_id", "action", "action_class", "timeout_seconds"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "executor_id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "action_class": {"enum": ["read", "write", "wait", "assert", "evidence", "cleanup"]},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
          "retry_policy": {"enum": ["none", "read_only", "verify_before_retry"]},
          "evidence_phase": {"enum": ["before", "action", "result", "refresh", "relogin", "downstream", "failure"]}
        }
      }
    },
    "password": {"not": {}},
    "token": {"not": {}},
    "cookie": {"not": {}},
    "credentials": {"not": {}}
  }
}
