{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-Case execution probe bound to existing approved baseline (not a second case list)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "mode", "baseline", "plan", "plan_sha256", "readiness_receipt", "profile", "profile_sha256", "environment_receipt", "oracle", "assertion_ids", "fixture", "action"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["standard", "rapid"]},
    "baseline": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"enum": ["approved", "provisional"]}}}]},
    "plan": {"$ref": "#/$defs/artifact"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "readiness_receipt": {"$ref": "#/$defs/artifact"},
    "profile": {"$ref": "#/$defs/artifact"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "environment_receipt": {"$ref": "#/$defs/artifact"},
    "oracle": {"$ref": "#/$defs/artifact"},
    "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["id", "business_key", "pre_state_sha256", "match_count"], "properties": {"id": {"type": "string", "minLength": 1}, "business_key": {"type": "string", "minLength": 1}, "pre_state_sha256": {"$ref": "#/$defs/hash"}, "match_count": {"const": 1}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "input_sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["read", "write"]}, "input_sha256": {"$ref": "#/$defs/hash"}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}}
  }
}
