{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution Step Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "step_id",
    "sequence",
    "executor_id",
    "target_id",
    "action_class",
    "status",
    "started_at",
    "finished_at",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "executor_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "action_class": {"enum": ["read", "write", "wait", "assert", "evidence", "cleanup"]},
    "status": {"enum": ["passed", "failed", "blocked", "skipped", "interrupted"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "state_before": {"type": ["object", "null"]},
    "state_after": {"type": ["object", "null"]},
    "correlation_ids": {"type": "object", "additionalProperties": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "read_only", "verify_before_retry"]},
        "attempt": {"type": "integer", "minimum": 1}
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "classification": {"type": "string"}
      }
    },
    "password": {"not": {}},
    "token": {"not": {}},
    "cookie": {"not": {}},
    "credentials": {"not": {}}
  }
}
