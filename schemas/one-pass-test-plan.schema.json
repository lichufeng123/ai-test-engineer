{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-test/one-pass-test-plan.schema.json",
  "title": "One-pass provisional test plan and visible cases",
  "type": "object",
  "required": ["schema_version", "run_id", "requirement_id", "mode", "feature", "environment", "platform", "scope", "result_authority", "knowledge_context", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "requirement_id": {"type": "string", "minLength": 1},
    "mode": {"const": "one_pass"},
    "feature": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "platform": {"enum": ["web", "api", "app", "h5", "miniapp"]},
    "result_authority": {"const": "provisional"},
    "scope": {"type": "object", "required": ["included", "excluded"], "properties": {
      "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}}
    }, "additionalProperties": false},
    "knowledge_context": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "read_status"], "properties": {
      "kind": {"type": "string", "minLength": 1},
      "read_status": {"enum": ["read", "unavailable"]},
      "path": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "reason": {"type": "string", "minLength": 1}
    }, "allOf": [{"if": {"properties": {"read_status": {"const": "read"}}}, "then": {"required": ["path", "sha256"]}},
                {"if": {"properties": {"read_status": {"const": "unavailable"}}}, "then": {"required": ["reason"]}}],
    "additionalProperties": false}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["case_id", "title", "source_ref", "expectation_status", "role", "fixture", "preconditions", "steps", "write_boundary", "stop_conditions"], "properties": {
      "case_id": {"type": "string", "pattern": "^OP-[A-Za-z0-9._-]+$"},
      "title": {"type": "string", "minLength": 1},
      "source_ref": {"type": "string", "minLength": 1},
      "expectation_status": {"enum": ["confirmed", "unknown"]},
      "readiness": {"enum": ["ready", "blocked"]},
      "blocker": {"type": "string", "minLength": 1},
      "role": {"type": "string", "minLength": 1},
      "fixture": {"type": "object", "required": ["id", "unique_locator", "scope"], "properties": {
        "id": {"type": "string", "minLength": 1},
        "unique_locator": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }, "additionalProperties": false},
      "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["step_id", "action", "expected", "oracle", "evidence_plan"], "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "oracle": {"type": "object", "required": ["source_ref", "independent"], "properties": {
          "source_ref": {"type": "string", "minLength": 1},
          "independent": {"const": true}
        }, "additionalProperties": false},
        "evidence_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }, "additionalProperties": false}},
      "write_boundary": {"type": "string", "minLength": 1},
      "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }, "allOf": [{"if": {"properties": {"readiness": {"const": "blocked"}}, "required": ["readiness"]}, "then": {"required": ["blocker"]}}], "additionalProperties": false}}
  },
  "additionalProperties": false
}
