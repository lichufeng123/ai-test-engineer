{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-test/one-pass-test-results.schema.json",
  "title": "One-pass case results tied to a frozen plan",
  "type": "object",
  "required": ["schema_version", "run_id", "plan_sha256", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["case_id", "status", "steps"], "properties": {
      "case_id": {"type": "string", "minLength": 1},
      "status": {"enum": ["passed", "failed", "blocked", "not_executed"]},
      "reason": {"type": "string", "minLength": 1},
      "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["step_id", "status"], "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "blocked", "not_executed"]},
        "actual": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }, "additionalProperties": false}}
    }, "additionalProperties": false}}
  }, "additionalProperties": false
}
