{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-test/rapid-test-charter.schema.json",
  "title": "Rapid Test Charter and Probe Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "mode",
    "status",
    "feature",
    "environment",
    "platforms",
    "timebox_minutes",
    "test_intent",
    "knowledge_context",
    "scope",
    "risk_hypotheses",
    "authorization",
    "probes",
    "result_authority",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"const": "rapid_test"},
    "status": {"enum": ["draft", "ready"]},
    "feature": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "timebox_minutes": {"type": "integer", "minimum": 1},
    "test_intent": {"type": "string", "minLength": 1},
    "knowledge_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_ref", "kind", "authority", "read_status"],
        "properties": {
          "source_ref": {"type": "string", "minLength": 1},
          "kind": {"enum": ["system_knowledge", "business_rule", "approved_baseline", "omission_risk", "test_method", "execution_asset", "run_receipt", "decision", "other"]},
          "authority": {"enum": ["approved", "reviewed_method", "pending", "historical", "inference", "unknown"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "read_status": {"enum": ["read", "unavailable", "not_applicable"]},
          "applicability": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "risk_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["risk_id", "statement", "impact", "likelihood", "priority"],
        "properties": {
          "risk_id": {"type": "string"},
          "statement": {"type": "string", "minLength": 1},
          "impact": {"enum": ["low", "medium", "high", "critical"]},
          "likelihood": {"enum": ["low", "medium", "high", "unknown"]},
          "priority": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "authorization": {
      "type": "object",
      "required": ["write_policy", "approved_actions", "forbidden_actions"],
      "properties": {
        "write_policy": {"enum": ["read_only", "mock_only", "authorized_non_production_write", "sensitive_action_requires_separate_confirmation"]},
        "approved_actions": {"type": "array", "items": {"type": "string"}},
        "forbidden_actions": {"type": "array", "items": {"type": "string"}},
        "authorization_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["probe_id", "risk_id", "status", "preconditions", "target_identity", "assertions", "fixture", "oracle", "action", "evidence_plan", "stop_and_recovery"],
        "properties": {
          "probe_id": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 1},
          "risk_id": {"type": "string"},
          "status": {"enum": ["draft", "frozen", "executed", "blocked", "superseded"]},
          "frozen_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "target_identity": {"type": "string", "minLength": 1},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["assertion_id", "expected", "directly_observable"],
              "properties": {
                "assertion_id": {"type": "string"},
                "expected": {"type": "string", "minLength": 1},
                "directly_observable": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "fixture": {
            "type": "object",
            "required": ["source", "unique_locator", "scope", "expected_state"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "unique_locator": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "minLength": 1},
              "expected_state": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "oracle": {
            "type": "object",
            "required": ["source", "independent_from_sut", "independence_rationale"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "independent_from_sut": {"type": "boolean"},
              "independence_rationale": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "action": {
            "type": "object",
            "required": ["description", "mutation_class"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "mutation_class": {"enum": ["read_only", "mock_only", "reversible_write", "irreversible_write"]},
              "approved_by_user": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "evidence_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "stop_and_recovery": {"type": "string", "minLength": 1},
          "observation_ref": {"type": "string"},
          "outcome": {"enum": ["passed_provisional", "failed", "blocked", "not_executed", "pending_triage"]},
          "revision_reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "result_authority": {"const": "provisional"},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "upgrade_triggers": {"type": "array", "items": {"type": "string"}},
    "technical_debt": {
      "type": "object",
      "properties": {
        "owner": {"type": ["string", "null"]},
        "due_date": {"type": ["string", "null"]},
        "follow_up": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "password": {"not": {}},
    "token": {"not": {}},
    "cookie": {"not": {}},
    "credentials": {"not": {}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
      "then": {
        "properties": {
          "probes": {
            "items": {
              "properties": {
                "status": {"const": "frozen"},
                "frozen_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "oracle": {"properties": {"independent_from_sut": {"const": true}}}
              },
              "required": ["frozen_sha256"]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
