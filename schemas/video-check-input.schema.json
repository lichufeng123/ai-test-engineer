{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Quality Check Input",
  "type": "object",
  "required": ["schema_version", "run_id", "videos"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "defaults": {"$ref": "#/$defs/thresholds"},
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/video"}
    }
  },
  "$defs": {
    "durationRange": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "minimum": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "blackThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_segment_seconds": {"type": "number", "exclusiveMinimum": 0},
        "picture_black_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "pixel_black_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "max_total_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_segment_seconds": {"type": "number", "minimum": 0},
        "rerecord_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "staticThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_segment_seconds": {"type": "number", "exclusiveMinimum": 0},
        "noise_tolerance": {"type": "number", "minimum": 0},
        "max_total_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_segment_seconds": {"type": "number", "minimum": 0},
        "rerecord_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "black_frames": {"$ref": "#/$defs/blackThresholds"},
        "static_frames": {"$ref": "#/$defs/staticThresholds"}
      }
    },
    "video": {
      "type": "object",
      "required": ["evidence_id", "case_id", "path", "expected_duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "expected_duration_seconds": {"$ref": "#/$defs/durationRange"},
        "step_labels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "description": "Traceability metadata only; phase one does not validate semantic content."
        },
        "thresholds": {"$ref": "#/$defs/thresholds"}
      }
    }
  }
}
