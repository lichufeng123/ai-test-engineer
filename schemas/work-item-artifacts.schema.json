{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-test/work-item-artifacts.schema.json",
  "title": "AI Test Requirement Work Item Artifact Registry",
  "type": "object",
  "required": [
    "schema_version",
    "requirement_id",
    "gate_requirements",
    "artifacts",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "requirement_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
    "gate_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["artifact_type", "acceptable_statuses"],
          "properties": {
            "artifact_type": {"type": "string"},
            "acceptable_statuses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "artifact_type",
          "path",
          "sha256",
          "status",
          "stage",
          "baseline_id",
          "run_id",
          "parent_artifact_id",
          "registered_at",
          "updated_at"
        ],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
          "artifact_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {
            "enum": [
              "generated",
              "validated",
              "review_pending",
              "review_exported",
              "review_validated",
              "approved",
              "synced",
              "not_applicable",
              "superseded"
            ]
          },
          "stage": {"type": "string", "minLength": 1},
          "baseline_id": {"type": ["string", "null"]},
          "run_id": {"type": ["string", "null"]},
          "parent_artifact_id": {"type": ["string", "null"]},
          "registered_at": {"type": "string"},
          "updated_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
