{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ai-test/work-item-manifest.schema.json",
  "title": "AI Test Requirement Work Item Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "requirement_id",
    "title",
    "feature",
    "environments",
    "platforms",
    "scope",
    "official_baseline"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "requirement_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
    "title": {"type": "string", "minLength": 1},
    "feature": {"type": "string", "minLength": 1},
    "environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["web", "app", "h5", "miniapp"]}
    },
    "scope": {"type": "string", "minLength": 1},
    "official_baseline": {
      "type": "object",
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
